rules_version = '2';
// Wealth Manager: paste this into Firebase console -> Firestore Database -> Rules -> Publish.
// Each person can only read and change their own record. Nobody can read anyone else's.
service cloud.firestore {
  match /databases/{database}/documents {

    // Account record: users/{uid}
    match /users/{uid} {
      function mine() { return request.auth != null && request.auth.uid == uid; }
      function allowedFields() {
        return request.resource.data.keys().hasOnly([
          'name', 'email', 'createdAt', 'lastOpenAt', 'appVersion', 'androidVersion',
          'deviceModel', 'pro', 'plan', 'usageConsent', 'usage']);
      }
      allow read, delete: if mine();
      allow create: if mine() && allowedFields() && request.resource.data.createdAt == request.time;
      allow update: if mine() && allowedFields()
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // Feedback: anyone signed in can send; only the sender can list or delete their own
    // (for account deletion). Nobody can read others' feedback from the app; you read it in the console.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'message', 'rating', 'replyTo', 'crash',
             'createdAt', 'appVersion', 'androidVersion', 'deviceModel', 'plan', 'status'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.get('crash', '').size() <= 8000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (!('replyTo' in request.resource.data) || request.resource.data.replyTo == request.auth.token.email);
      allow list, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow get, update: if false;
    }

    // Trial start per Google account, keyed by a one-way hash of the email.
    // Can be created once (with the server's own time) and never changed or deleted by the app.
    match /trials/{id} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['start'])
        && request.resource.data.start == request.time;
      allow list, update, delete: if false;
    }
  }
}
